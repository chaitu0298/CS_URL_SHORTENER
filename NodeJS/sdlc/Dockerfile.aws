# Bounded engineering runner. No deploy tools or AWS credentials in task role.
FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY NodeJS/package*.json ./
RUN npm install --omit=dev --no-audit --no-fund && npm cache clean --force
COPY NodeJS/src/ ./src/
COPY NodeJS/sdlc/ ./sdlc/
# SDLC sources are image-baked; only /data/runs is writable (EFS access point).
USER node
EXPOSE 3100
CMD ["node", "sdlc/api.mjs"]
